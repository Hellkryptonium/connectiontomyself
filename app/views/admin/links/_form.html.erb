<header class="site-header"><h1><%= heading %></h1></header><main><% if link.errors.any? %><p class="form-error"><%= link.errors.full_messages.to_sentence %></p><% end %><%= form_with model: [:admin, link] do |form| %><p><%= form.label :title %><br><%= form.text_field :title, required: true %></p><p><%= form.label :url %><br><%= form.url_field :url, required: true %></p><p><%= form.label :description %><br><%= form.text_area :description, rows: 4 %></p><p><%= form.label :category %><br><%= form.text_field :category %></p><p><%= form.label :position %><br><%= form.number_field :position %></p><%= form.submit "save link" %><% end %><p><%= link_to "← links", admin_links_path %></p></main>
