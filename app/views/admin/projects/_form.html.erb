<header class="site-header"><h1><%= heading %></h1></header><main><% if project.errors.any? %><p class="form-error"><%= project.errors.full_messages.to_sentence %></p><% end %><%= form_with model: [:admin, project] do |form| %><p><%= form.label :title %><br><%= form.text_field :title, required: true %></p><p><%= form.label :slug %><br><%= form.text_field :slug %></p><p><%= form.label :description %><br><%= form.text_area :description, required: true, rows: 4 %></p><p><%= form.label :body_markdown %><br><%= form.text_area :body_markdown, rows: 12 %></p><p><%= form.label :status %><br><%= form.text_field :status, required: true %></p><p><%= form.label :technologies %><br><%= form.text_field :technologies %></p><p><%= form.label :external_url %><br><%= form.url_field :external_url %></p><%= form.submit "save project" %><% end %><p><%= link_to "← projects", admin_projects_path %></p></main>
