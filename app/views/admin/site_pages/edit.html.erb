<% content_for :title, "Edit #{@page.title} · connectiontomyself" %>
<div class="site admin-site"><header class="site-header"><h1>edit <%= @page.title.downcase %></h1></header><main><% if @page.errors.any? %><p class="form-error"><%= @page.errors.full_messages.to_sentence %></p><% end %><%= form_with model: [:admin, @page] do |form| %><p><%= form.label :title %><br><%= form.text_field :title, required: true %></p><p><%= form.label :subtitle %><br><%= form.text_field :subtitle %></p><p><%= form.label :body_markdown %><br><%= form.text_area :body_markdown, rows: 20, required: true %></p><%= form.submit "save page" %><% end %><p><%= link_to "← pages", admin_site_pages_path %></p></main></div>
