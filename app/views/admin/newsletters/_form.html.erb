<header class="site-header">
  <p class="site-mark"><%= link_to "connectiontomyself", root_path %></p>
  <div class="admin-heading"><div><p class="eyebrow">direct to subscribers</p><h1><%= heading %></h1></div><%= link_to "back to newsletters", admin_newsletters_path, class: "button-link button-secondary" %></div>
  <%= render "admin/nav" %>
</header>
<main>
  <% if newsletter.errors.any? %><div class="flash flash-error"><%= newsletter.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: [:admin, newsletter] do |form| %>
    <div class="editor-grid">
      <div class="editor-main"><div class="field"><%= form.label :subject, "Subject" %><%= form.text_field :subject, required: true, maxlength: 180, placeholder: "A note from connectiontomyself" %></div><div class="field"><%= form.label :body_markdown, "Newsletter" %><p class="field-help">This is separate from your public writings. Write the message you want subscribers to receive.</p><%= form.text_area :body_markdown, rows: 24, required: true, placeholder: "Hello,\n\nHere is what I wanted to share..." %></div></div>
      <aside class="editor-sidebar"><div class="sidebar-box"><h2>Before sending</h2><p class="field-help">Save the draft first. Check the subject and message, then send it once to active subscribers.</p><%= form.submit "save draft", class: "button-primary button-wide" %></div></aside>
    </div>
  <% end %>
</main>
