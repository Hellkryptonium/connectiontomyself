<% content_for :title, "Archive · connectiontomyself" %>
<div class="site"><header class="site-header"><p class="site-mark"><%= link_to "connectiontomyself", root_path %></p><h1>archive</h1><p class="tagline">everything published, in order</p></header><main><% if @posts_by_month.any? %><% @posts_by_month.each do |month, posts| %><section><h2><%= month.to_fs(:month_and_year) %></h2><ul><% posts.each do |post| %><li><%= link_to post.title, writing_path(post.slug) %> <small><%= post.published_at.to_date.to_fs(:long) %></small></li><% end %></ul></section><% end %><% else %><p>The archive is empty for now.</p><% end %></main><footer><p><%= link_to "← writings", writings_path %></p></footer></div>
